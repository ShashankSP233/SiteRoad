    ? await db.prepare('SELECT * FROM project_budgets WHERE period=? ORDER BY project_id').all(period)
    : await db.prepare('SELECT * FROM project_budgets ORDER BY period DESC, project_id').all();
  res.json(rows.map(b => ({
